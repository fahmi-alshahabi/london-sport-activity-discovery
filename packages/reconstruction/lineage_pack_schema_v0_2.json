{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:closing-the-activity-gap:lineage-pack:0.2",
 "title": "Lineage pack v0.2 (PROPOSED)",
 "description": "One decision over one slate, made fully auditable: every predicate the decision used, its evidence state, the value relied on, the served RPDE page that value came from, and the receipts that bind those pages and files to the run. Seven parts, matching LINEAGE_PACK_WORKED_EXAMPLE_v0_1: _status, decision_ref, candidates, evidence (per candidate), lineage (per candidate), receipts, versions, limits. Generated by lineage_pack_v0_1.py from an S1 engine v0.3.1+ run directory and a query file; never hand-written. v0.2 (13 Sep 2026, §09-1 clauses 2/4): evidence[].grade is the envelope's strength grade ('explicit' | null); evidence[].provenance ('on_record' | 'inherited_from_parent') is present iff evidence_state == 'T'; lineage_class unchanged; versions.provenance_map added. Digest rule unchanged.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "_status",
  "pack_schema",
  "decision_ref",
  "query",
  "candidates",
  "receipts",
  "versions",
  "limits"
 ],
 "properties": {
  "_status": {
   "type": "string",
   "minLength": 1
  },
  "pack_schema": {
   "const": "lineage-pack-0.2-PROPOSED"
  },
  "decision_ref": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "query_id",
    "terminal_decision",
    "decision_digest",
    "digest_rule",
    "slate_size",
    "pools"
   ],
   "properties": {
    "query_id": {
     "type": "string",
     "minLength": 1
    },
    "task_ref": {
     "type": [
      "string",
      "null"
     ]
    },
    "terminal_decision": {
     "enum": [
      "supported_match",
      "evidence_indeterminate",
      "bounded_non_match",
      "no_candidates"
     ]
    },
    "decision_digest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "digest_rule": {
     "type": "string"
    },
    "slate_size": {
     "type": "integer",
     "minimum": 0
    },
    "pools": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "supported",
      "indeterminate",
      "non_match"
     ],
     "properties": {
      "supported": {
       "type": "integer",
       "minimum": 0
      },
      "indeterminate": {
       "type": "integer",
       "minimum": 0
      },
      "non_match": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  },
  "query": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "query_id",
    "constraints"
   ],
   "properties": {
    "query_id": {
     "type": "string"
    },
    "task_ref": {
     "type": [
      "string",
      "null"
     ]
    },
    "constraints": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "predicate_id",
       "field",
       "matcher"
      ],
      "properties": {
       "predicate_id": {
        "enum": [
         "has-located-venue",
         "has-start-datetime",
         "has-activity-classification",
         "has-name",
         "has-organizer",
         "has-offer-information",
         "has-booking-url",
         "has-attendee-instructions"
        ]
       },
       "field": {
        "enum": [
         "location",
         "startDate",
         "activity",
         "name",
         "organizer",
         "offers",
         "url",
         "attendeeInstructions"
        ]
       },
       "matcher": {
        "enum": [
         "text",
         "date_window"
        ]
       },
       "value": {
        "type": "string"
       },
       "start": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "end": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       }
      }
     }
    }
   }
  },
  "candidates": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "candidate_id",
     "item_id",
     "provider",
     "rank",
     "pool",
     "decision",
     "detail",
     "parent_resolution",
     "evidence",
     "lineage"
    ],
    "properties": {
     "candidate_id": {
      "type": "string",
      "minLength": 1
     },
     "item_id": {
      "type": "string",
      "minLength": 1
     },
     "provider": {
      "type": "string",
      "minLength": 1
     },
     "rank": {
      "type": "integer",
      "minimum": 1
     },
     "pool": {
      "enum": [
       "supported",
       "indeterminate",
       "non_match"
      ]
     },
     "decision": {
      "enum": [
       "supported_match",
       "evidence_indeterminate",
       "bounded_non_match"
      ]
     },
     "detail": {
      "type": "object"
     },
     "parent_resolution": {
      "enum": [
       "RESOLVED",
       "PARENT_NOT_IN_SAMPLE",
       "NO_SUPEREVENT"
      ]
     },
     "parent_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "predicate_id",
        "field",
        "evidence_state",
        "lineage_class",
        "grade",
        "mechanism",
        "verdict"
       ],
       "properties": {
        "predicate_id": {
         "type": "string"
        },
        "field": {
         "type": "string"
        },
        "evidence_state": {
         "enum": [
          "T",
          "U"
         ]
        },
        "lineage_class": {
         "enum": [
          "ON_CHILD",
          "CHILD_OVERRIDES",
          "BOTH_EQUAL",
          "INHERITED",
          "SOURCE_ABSENT",
          "UNRESOLVABLE_PARENT_UNAVAILABLE",
          "ABSENT_CHILD_ONLY_FIELD"
         ]
        },
        "grade": {
         "enum": [
          "explicit",
          null
         ],
         "description": "Strength grade (§09-1 cl.2). An INHERITED value is 'explicit' — published on the parent. null on U rows: the pack applies no specification default."
        },
        "mechanism": {
         "type": "string"
        },
        "verdict": {
         "enum": [
          "T:satisfied",
          "T:unsatisfied",
          "U"
         ]
        },
        "provenance": {
         "enum": [
          "on_record",
          "inherited_from_parent"
         ],
         "description": "Locus of the published value (§09-1 cl.1), projected from lineage_class by provenance_map.py. Present iff evidence_state == 'T'."
        }
       },
       "allOf": [
        {
         "if": {
          "properties": {
           "evidence_state": {
            "enum": [
             "T"
            ]
           }
          }
         },
         "then": {
          "required": [
           "provenance"
          ],
          "properties": {
           "grade": {
            "enum": [
             "explicit"
            ]
           }
          }
         }
        },
        {
         "if": {
          "properties": {
           "evidence_state": {
            "enum": [
             "U"
            ]
           }
          }
         },
         "then": {
          "not": {
           "required": [
            "provenance"
           ]
          },
          "properties": {
           "grade": {
            "enum": [
             null
            ]
           }
          }
         }
        }
       ]
      }
     },
     "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "predicate_id",
        "field",
        "value",
        "json_path",
        "rule",
        "source"
       ],
       "properties": {
        "predicate_id": {
         "type": "string"
        },
        "field": {
         "type": "string"
        },
        "value": {},
        "json_path": {
         "type": "string"
        },
        "rule": {
         "type": "string"
        },
        "source": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "$ref": "#/$defs/source"
          }
         ]
        },
        "corroborating_source": {
         "$ref": "#/$defs/source"
        },
        "overridden_source": {
         "$ref": "#/$defs/source"
        }
       }
      }
     }
    }
   }
  },
  "receipts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "master_receipt_sha256",
    "engine_sha256",
    "pages",
    "files",
    "ledger"
   ],
   "properties": {
    "master_receipt_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "engine_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "source_feed",
       "page_index",
       "page_sha256",
       "ledger_status"
      ],
      "properties": {
       "source_feed": {
        "type": "string"
       },
       "page_index": {
        "type": "integer",
        "minimum": 0
       },
       "page_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "ledger_status": {
        "enum": [
         "ledger_bound",
         "ledger_not_checked"
        ]
       }
      }
     }
    },
    "files": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "provider",
       "file",
       "sha256",
       "bound_to_master_receipt"
      ],
      "properties": {
       "provider": {
        "type": "string"
       },
       "file": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "bound_to_master_receipt": {
        "const": true
       }
      }
     }
    },
    "ledger": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "enum": [
        "checked_against_pages_csv",
        "not_supplied"
       ]
      },
      "pages_csv_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "matches_master_receipt": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "versions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "corpus_vintage",
    "snapshot",
    "engine",
    "policy",
    "interpretation",
    "reducer",
    "b0_class_map",
    "s1b_parameters",
    "seed",
    "provenance_map"
   ],
   "properties": {
    "corpus_vintage": {
     "type": "string"
    },
    "snapshot": {
     "type": [
      "string",
      "null"
     ]
    },
    "engine": {
     "type": "string"
    },
    "policy": {
     "type": "string"
    },
    "interpretation": {
     "type": "string"
    },
    "reducer": {
     "type": "string"
    },
    "b0_class_map": {
     "type": "string"
    },
    "s1b_parameters": {
     "type": [
      "object",
      "null"
     ]
    },
    "seed": {
     "type": "null"
    },
    "provenance_map": {
     "type": "string"
    }
   }
  },
  "limits": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "role",
    "item",
    "source_feed",
    "rpde_modified",
    "page_index",
    "page_sha256"
   ],
   "properties": {
    "role": {
     "enum": [
      "child",
      "parent"
     ]
    },
    "item": {
     "type": "string"
    },
    "item_at_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "kind": {
     "type": [
      "string",
      "null"
     ]
    },
    "source_feed": {
     "type": "string"
    },
    "rpde_modified": {},
    "page_index": {
     "type": "integer",
     "minimum": 0
    },
    "page_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "page_license": {}
   }
  }
 }
}
