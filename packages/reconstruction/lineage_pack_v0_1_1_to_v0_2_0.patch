+def migrate_pack_v0_1_to_v0_2(pack, pm=None):
+    """Re-project the evidence rows of a v0.1 pack to v0.2 form. Decisions, slate, receipts and the digest are
+    NOT touched — only evidence[].grade (lineage grade -> strength) and evidence[].provenance (added on T rows).
+    A verification aid: it lets the two delivered packs be checked against schema v0.2 and their stored
+    digests without re-running the corpus. The output is labelled as migrated; it is not a fresh generation."""
+    pm = pm or _import_provenance_map()
+    if pack.get("pack_schema") != "lineage-pack-0.1-PROPOSED":
+        die(f"migrate expects a lineage-pack-0.1-PROPOSED pack, got {pack.get('pack_schema')!r}")
+    out = json.loads(json.dumps(pack))
+    for c in out["candidates"]:
+        for e in c["evidence"]:
+            state, cls = e["evidence_state"], e["lineage_class"]
+            try:
+                e["grade"], prov = pm.strength_of(e["grade"]), pm.provenance_of(cls)
+            except pm.ProvenanceMapError as ex:
+                die(f"migrate: §09-1 projection refused on {c['candidate_id']}.{e['field']}: {ex}")
+            if (prov is not None) != (state == "T"):
+                die(f"migrate: provenance/evidence_state disagree on {c['candidate_id']}.{e['field']}")
+            if prov is not None:
+                e["provenance"] = prov
+            else:
+                e.pop("provenance", None)
+    out["pack_schema"] = PACK_SCHEMA_ID
+    out["versions"]["provenance_map"] = pm.PROVENANCE_MAP_VERSION
+    src_sha = sha(canon(pack))
+    out["_status"] = (f"LINEAGE PACK v0.2 — PROPOSED; MIGRATED by {GENERATOR_VERSION} from a v0.1 pack (canonical sha "
+                      f"{src_sha[:16]}…); evidence rows re-projected per §09-1 clauses (2)/(4); decisions and digest untouched. "
+                      f"Original: {pack.get('_status')}")
+    out["limits"] = [l.replace("in pack v0.1", "in pack v0.2") for l in out["limits"]] + [
+        "MIGRATED from a v0.1 pack: evidence[].grade re-projected lineage->strength and evidence[].provenance added on T "
+        "rows; decisions, slate, detail, lineage, receipts and the digest are untouched. A fresh v0.2 generation over the "
+        "same run would differ from this file in _status, in limits (this entry is absent from a fresh build, and any limit "
+        "the current generator emits that the source generator did not is present in it — for a generator-0.1 source that "
+        "is the clause-2 entry and the integrity-vs-validity entry) and, for packs generated before v0.1.1, in "
+        "decision_ref.digest_rule wording; it would not differ in any digested or evidential value"]
+    schema = json.loads((Path(__file__).resolve().parent / SCHEMA_FILE).read_text(encoding="utf-8"))
+    errs = validate(out, schema)
+    if errs:
+        die("migrated pack fails schema v0.2: " + "; ".join(errs[:5]))
+    return out
+
